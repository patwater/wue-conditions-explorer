metadata:
  effective_date: 07/01/2011
  utility_name: Valley Small Town
  bill_frequency: Bimonthly
  bill_unit: ccf
  note: SYNTHETIC rate structure for simulated data; not any real utility's rates.
rate_structure:
  RESIDENTIAL_SINGLE:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 25.96
        3/4: 30.28
        '1': 43.26
        1|1/2: 82.2
        '2': 129.79
        '3': 259.58
        '4': 432.64
    commodity_charge: Tiered
    tier_starts_commodity:
    - 0.0
    - 16.0
    - 40.0
    - 80.0
    tier_prices_commodity:
    - 1.95
    - 2.49
    - 3.24
    - 4.43
    bill: service_charge+commodity_charge
