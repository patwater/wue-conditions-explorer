metadata:
  effective_date: 01/01/2010
  utility_name: Valley Small Town
  bill_frequency: Bimonthly
  bill_unit: ccf
  note: SYNTHETIC rate structure for simulated data; not any real utility's rates.
rate_structure:
  RESIDENTIAL_SINGLE:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 24.0
        3/4: 28.0
        '1': 40.0
        1|1/2: 76.0
        '2': 120.0
        '3': 240.0
        '4': 400.0
    commodity_charge: Tiered
    tier_starts_commodity:
    - 0.0
    - 16.0
    - 40.0
    - 80.0
    tier_prices_commodity:
    - 1.8
    - 2.3
    - 3.0
    - 4.1
    bill: service_charge+commodity_charge
  RESIDENTIAL_MULTI:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 24.0
        3/4: 28.0
        '1': 40.0
        1|1/2: 76.0
        '2': 120.0
        '3': 240.0
        '4': 400.0
    commodity_charge: Uniform
    price_commodity: 2.7
    bill: service_charge+commodity_charge
