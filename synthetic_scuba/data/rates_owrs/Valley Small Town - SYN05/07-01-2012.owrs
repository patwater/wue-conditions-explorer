    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 27.0
        3/4: 31.5
        '1': 44.99
        1|1/2: 85.49
        '2': 134.98
        '3': 269.97
        '4': 449.95
    commodity_charge: Tiered
    tier_starts_commodity:
