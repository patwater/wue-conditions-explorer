metadata:
  effective_date: 07/01/2015
  utility_name: So Cal Suburb
  bill_frequency: Monthly
  bill_unit: ccf
  note: SYNTHETIC rate structure for simulated data; not any real utility's rates.
rate_structure:
  RESIDENTIAL_SINGLE:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 15.18
        3/4: 17.71
        '1': 25.31
        1|1/2: 48.08
        '2': 75.92
        '3': 151.84
        '4': 253.06
    commodity_charge: Budget
    gpcd_commodity: 55
    indoor_commodity: hhsize*gpcd*days_in_period*(1/748)
    outdoor_commodity: landscape_factor*et_amount*irr_area*0.62*(1/748)
    budget_commodity: indoor+outdoor
    landscape_factor_commodity: 0.7
    tier_starts_commodity:
    - 0.0
    - indoor
    - 100%
    - 150%
    tier_prices_commodity:
    - 2.66
    - 3.29
    - 5.31
    - 9.49
    bill: service_charge+commodity_charge
  RESIDENTIAL_MULTI:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 15.18
        3/4: 17.71
        '1': 25.31
        1|1/2: 48.08
        '2': 75.92
        '3': 151.84
        '4': 253.06
    commodity_charge: Uniform
    price_commodity: 3.42
    bill: service_charge+commodity_charge
