metadata:
  effective_date: 01/01/2010
  utility_name: So Cal Suburb
  bill_frequency: Monthly
  bill_unit: ccf
  note: SYNTHETIC rate structure for simulated data; not any real utility's rates.
rate_structure:
  RESIDENTIAL_SINGLE:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Budget
    gpcd_commodity: 55
    indoor_commodity: hhsize*gpcd*days_in_period*(1/748)
    outdoor_commodity: landscape_factor*et_amount*irr_area*0.62*(1/748)
    budget_commodity: indoor+outdoor
    landscape_factor_commodity: 0.7
    tier_starts_commodity:
    - 0.0
    - indoor
    - 100%
    - 150%
    tier_prices_commodity:
    - 2.1
    - 2.6
    - 4.2
    - 7.5
    bill: service_charge+commodity_charge
  RESIDENTIAL_MULTI:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Uniform
    price_commodity: 2.7
    bill: service_charge+commodity_charge
  COMMERCIAL:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Uniform
    price_commodity: 2.8
    bill: service_charge+commodity_charge
  INDUSTRIAL:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Uniform
    price_commodity: 2.7
    bill: service_charge+commodity_charge
  INSTITUTIONAL:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Uniform
    price_commodity: 2.8
    bill: service_charge+commodity_charge
  OTHER:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
        3/4: 14.0
        '1': 20.0
        1|1/2: 38.0
        '2': 60.0
        '3': 120.0
        '4': 200.0
    commodity_charge: Uniform
    price_commodity: 2.9
    bill: service_charge+commodity_charge
  IRRIGATION:
    service_charge:
      depends_on:
      - meter_size
      values:
        5/8: 12.0
